      "dot": "cyan",
      "title": "AgentCore MCP Gateway",
      "items": [
        "Uses built-in connector states to expose Step Functions APIs as standardized MCP tools.",
        "Target config pins stateMachineArn so agent cannot divert to arbitrary workflows."
      ]
    },
    {
      "dot": "emerald",
      "title": "Robust State Machine Orchestration",
      "items": [
        "ValidateInput Choice state enforces S3 path safety regex before starting heavy ETL.",
        "startJobRun.sync synchronously tracks Glue completion with retry backoff and catch blocks."
      ]
    },
    {
      "dot": "rose",
      "title": "Least-Privilege & Observability",
      "items": [
        "Execution roles scoped strictly to state machine ARN and execution ARN prefix.",
